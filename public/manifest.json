{
  "manifest_version": 3,
  "name": "PostReady \u2014 YouTube to X",
  "version": "0.2.0",
  "description": "Turn a YouTube link into a verified MP4 for X, with the PostReady local companion.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "downloads"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "PostReady",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:3002; img-src 'self' https://i.ytimg.com data:; media-src 'self' http://127.0.0.1:3002; style-src 'self' 'unsafe-inline'; font-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
